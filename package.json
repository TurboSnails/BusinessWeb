{
  "name": "study01-react-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "valuation:server": "node server/valuation/index.mjs",
    "valuation": "node scripts/valuation-cli.mjs",
    "valuation:app": "node scripts/valuation-app.mjs",
    "test:valuation-server": "node --test server/valuation/*.test.mjs",
    "test": "node scripts/run-vitest.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.grid.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.valuation.json",
    "prebuild": "node scripts/generate-changelog.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "build:pages": "VITE_BASE_PATH=/BusinessWeb/ VITE_MARKET_DIRECT=true VITE_API_BASE=https://business-web-black.vercel.app vite build && node scripts/prepare-pages.mjs",
    "test:functions": "node scripts/check-functions.mjs",
    "test:scripts": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@types/react-router-dom": "^5.3.3",
    "lucide-react": "^0.562.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^18.2.28",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.1.0",
    "vite": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "24.x"
  },
  "type": "module"
}
