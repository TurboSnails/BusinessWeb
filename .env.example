# Optional front-end build settings. Vercel defaults to the root path.
VITE_BASE_PATH=/
VITE_MARKET_DIRECT=false

# SERVER ONLY: optional independent grid sync. Never prefix these with VITE_.
# Set these in Vercel's project environment settings; leave empty to disable sync.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
GRID_SYNC_TOKEN=

# Optional external Python AKTools service. This is not provided by Vercel.
VITE_AKTOOLS_BASE_URL=

# SERVER ONLY: independent private-library credentials (>=32 chars, all distinct).
KNOWLEDGE_READ_TOKEN=
KNOWLEDGE_MCP_TOKEN=
KNOWLEDGE_UPLOAD_TOKEN=

# SERVER ONLY: independent read/write Obsidian sync credential, >=32 chars.
KNOWLEDGE_SYNC_TOKEN=
