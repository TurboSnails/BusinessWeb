{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/invest/ai-tools",
      "destination": "/ai/ai-skills",
      "permanent": true
    },
    {
      "source": "/ai-skills/dev-team-README.md",
      "destination": "/ai/dev-team",
      "permanent": false
    }
  ],
  "functions": {
    "api/ask.ts": {
      "maxDuration": 30
    },
    "api/market-data/[marketRoute].js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/macro", "destination": "/api/market-data/macro" },
    { "source": "/api/indexes", "destination": "/api/market-data/indexes" },
    { "source": "/api/sentiment", "destination": "/api/market-data/sentiment" },
    { "source": "/api/daily-analysis", "destination": "/api/market-data/daily-analysis" },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/:file(dev-team-README-[^/]+\\.md)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"dev-team-README.md\""
        }
      ]
    },
    {
      "source": "/assets/:file(dropshipping-strategy-[^/]+\\.md)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"dropshipping-strategy.md\"; filename*=UTF-8''%E6%97%A0%E8%B4%A7%E6%BA%90%E7%94%B5%E5%95%86-30%E5%A4%A9%E5%AE%9E%E6%96%BD%E6%96%B9%E6%A1%88.md"
        }
      ]
    },
    {
      "source": "/templates/dropshipping-orders.csv",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"dropshipping-orders.csv\"; filename*=UTF-8''%E6%97%A0%E8%B4%A7%E6%BA%90%E7%94%B5%E5%95%86-%E8%AE%A2%E5%8D%95%E8%AE%B0%E8%B4%A6%E6%A8%A1%E6%9D%BF.csv"
        }
      ]
    },
    {
      "source": "/first-book/:file([^/]+\\.md)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
